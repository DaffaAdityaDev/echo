                "ProviderOpenAI",
                "ProviderAnthropic",
                "ProviderLMStudio",
                "ProviderOpenCode"
            ]
        },
        "internal_handler_aimodel.ModelsResponse": {
            "type": "object",
            "properties": {
                "models": {
                    "description": "Models lists the available AI models.",
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/echo-backend_internal_models_ai.ModelInfo"
                    }
                }
            }
        }
