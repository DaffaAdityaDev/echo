          "409": {
            "description": "Conflict",
            "schema": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "schema": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        },
        "security": [
          {
            "InternalAuth": []
          }
        ],
        "consumes": ["application/json"],
        "produces": ["application/json"]
      }
    },
    "/api/v1/internal/memory/semantic/search": {
      "post": {
        "tags": ["Memory"],
        "summary": "Search semantic memory",
        "description": "Searches the session owner's semantic memory by query text (internal)",
        "parameters": [
          {
            "description": "Semantic search payload",
            "name": "request",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/internal_handler_memory.semanticSearchRequest"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Matching semantic memory entries",
            "schema": {
              "$ref": "#/definitions/internal_handler_memory.SemanticSearchResponse"
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "404": {
            "description": "Unknown or deleted session",
            "schema": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "schema": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        },
        "security": [
          {
            "InternalAuth": []
          }
        ],
        "consumes": ["application/json"],
        "produces": ["application/json"]
      }
    },
    "/api/v1/internal/memory/semantic/store": {
      "post": {
        "tags": ["Memory"],
        "summary": "Store semantic memory",
        "description": "Stores a semantic memory entry with an optional embedding, owned by the user that owns the session (internal)",
        "parameters": [
          {
            "description": "Semantic memory payload",
            "name": "request",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/internal_handler_memory.semanticStoreRequest"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Indexed entry",
            "schema": {
              "$ref": "#/definitions/internal_handler_memory.SemanticStoreResponse"
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "404": {
            "description": "Unknown or deleted session",
            "schema": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "409": {
            "description": "ID is owned by another user",
            "schema": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "schema": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        },
        "security": [
          {
            "InternalAuth": []
          }
        ],
        "consumes": ["application/json"],
        "produces": ["application/json"]
      }
    }
  },
  "securityDefinitions": {
    "BearerAuth": {
      "description": "Bearer token authorization header (Format: Bearer \u003cJWT\u003e).",
      "type": "apiKey",
      "name": "Authorization",
      "in": "header"
    },
    "InternalAuth": {
      "description": "Internal service JWT token (Format: Bearer \u003cservice JWT\u003e).",
      "type": "apiKey",
      "name": "X-Internal-Token",
      "in": "header"
    }
  },
