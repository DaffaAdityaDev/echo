        "summary": "Recall episodic memory",
        "description": "Recalls episodic memory entries for a session, scoped to the user that owns the session (internal)",
        "parameters": [
          {
            "description": "Episodic recall payload",
            "name": "request",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/internal_handler_memory.episodicRecallRequest"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Recalled episodic memory entries",
            "schema": {
              "$ref": "#/definitions/internal_handler_memory.EpisodicRecallResponse"
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "404": {
            "description": "Unknown or deleted session",
            "schema": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "schema": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "schema": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        },
        "security": [
          {
            "InternalAuth": []
          }
        ],
        "consumes": ["application/json"],
        "produces": ["application/json"]
      }
    },
    "/api/v1/internal/memory/episodic/store": {
      "post": {
        "tags": ["Memory"],
        "summary": "Store episodic memory",
        "description": "Stores an episodic memory entry for a session, scoped to the user that owns the session (internal)",
        "parameters": [
          {
            "description": "Episodic memory payload",
            "name": "request",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/internal_handler_memory.episodicStoreRequest"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Stored entry",
            "schema": {
              "$ref": "#/definitions/internal_handler_memory.StoreEpisodicResponse"
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "404": {
            "description": "Unknown or deleted session",
            "schema": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "schema": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "schema": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        },
        "security": [
          {
            "InternalAuth": []
          }
        ],
        "consumes": ["application/json"],
        "produces": ["application/json"]
      }
    },
    "/api/v1/internal/memory/procedural/get": {
      "post": {
        "tags": ["Memory"],
        "summary": "Get procedural memory",
        "description": "Retrieves one of the session owner's procedural memory entries by ID or name (internal)",
        "parameters": [
          {
            "description": "Procedural recall payload",
            "name": "request",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/internal_handler_memory.proceduralGetRequest"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Procedural memory entry",
            "schema": {
              "$ref": "#/definitions/internal_handler_memory.ProceduralGetResponse"
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "404": {
            "description": "Unknown session or entry",
            "schema": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "schema": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        },
        "security": [
          {
            "InternalAuth": []
          }
        ],
        "consumes": ["application/json"],
        "produces": ["application/json"]
      }
    },
    "/api/v1/internal/memory/procedural/store": {
      "post": {
        "tags": ["Memory"],
        "summary": "Store procedural memory",
        "description": "Stores a procedural memory entry owned by the user that owns the session (internal)",
        "parameters": [
          {
            "description": "Procedural memory payload",
            "name": "request",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/internal_handler_memory.proceduralStoreRequest"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Recorded entry",
            "schema": {
              "$ref": "#/definitions/internal_handler_memory.ProceduralStoreResponse"
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "404": {
            "description": "Unknown or deleted session",
            "schema": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
