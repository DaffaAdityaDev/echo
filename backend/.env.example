PORT=8080
DATABASE_URL=postgres://user:password@localhost:5432/echo_db?sslmode=disable
JWT_SECRET=replace-this-with-a-secure-secret
SERVICE_JWT_SECRET=change-this-to-a-secure-service-jwt-secret-min32chars
ENVIRONMENT=development
AGENT_HTTP_URL=http://localhost:3001
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
ENABLE_OTEL=false
INTERNAL_AUTH_TOKEN=change-me-internal-token

# Default model when user doesn't specify
DEFAULT_MODEL=opencode-go/deepseek-v4-flash

# Loki log shipping (all optional — leave empty to keep console-only)
# LOKI_URL=http://localhost:3100
# LOKI_USER=
# LOKI_PASSWORD=
# LOKI_TENANT_ID=
# LOKI_LABELS=tenant=acme,project=echo

# Encryption key for user API key storage (must be exactly 32 characters for AES-256)
ENCRYPTION_KEY=change-this-to-a-32-char-key!!!!

# Lifecycle worker interval
WORKER_INTERVAL=15m

# Memory decay windows in days
DECAY_DEPRECATE_AFTER=30
DECAY_ARCHIVE_AFTER=90

# Default rollout for new strategy versions (e.g. "0.1" = 10%)
STRATEGY_ROLLOUT_DEFAULT=0.1

# Context-window-aware consolidation (tokens)
# PRUNE_THRESHOLD=100000
# PRUNE_KEEP_LATEST_TURNS=10
# SUMMARIZE_MAX_TOKENS=500
# HISTORY_MAX_TOKENS=50000            # explicit payload budget override (wins over ratio)
# HISTORY_MAX_MSG_CHARS=100000        # per-message char truncation for chat history
# CONSOLIDATION_SKIP_TOKENS=200000    # explicit skip threshold override (wins over ratio)
# CONSOLIDATION_SKIP_RATIO=90         # % of model context window: sessions above are skipped
# SUMMARIZE_PAYLOAD_RATIO=60          # % of model context window: summarize payload budget


