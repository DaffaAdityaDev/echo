{
  "openapi": "3.0.3",
  "info": {
    "title": "Echo Agent Platform API",
    "version": "1.0.0",
    "description": "Autonomous AI Agent Platform runtime, mission execution engine, skills, features, and model proxy API.\n\nTriggers autonomous agent execution loops using configurable LLM providers (OpenAI, Anthropic, LM Studio, OpenCode Go) with full tool-calling, memory, and streaming support."
  },
  "servers": [
    {
      "url": "/",
      "description": "Current Environment Server"
    }
  ],
  "tags": [
    {
      "name": "Health",
      "description": "Agent platform health checks"
    },
    {
      "name": "Features",
      "description": "Feature catalog with tier requirements"
    },
    {
      "name": "Generate Mission",
      "description": "Autonomous mission execution (SSE stream)"
    },
    {
      "name": "Internal",
      "description": "Internal service-to-service endpoints"
    },
    {
      "name": "Missions",
      "description": "Mission lifecycle and human-in-the-loop actions"
    },
    {
      "name": "Models",
      "description": "LLM provider model catalog"
    },
    {
      "name": "Skills",
      "description": "Agent skill catalog"
    },
    {
      "name": "Strategies",
      "description": "Versioned strategy catalog"
    }
  ],
  "security": [
    {
      "InternalTokenAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "InternalTokenAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Internal-Token",
        "description": "Internal service-to-service authentication token"
      },
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "User JWT Bearer token for authenticated API access"
      }
    }
  }
}
