PORT=3001
GRPC_PORT=50051
CHROMA_URL=http://localhost:8000
STATE_BACKEND=memory
INTERNAL_AUTH_TOKEN=default-internal-token-secret
SERVICE_JWT_SECRET=change-this-to-a-secure-service-jwt-secret-min32chars
BACKEND_URL=http://localhost:8080
NODE_ENV=development

# Langfuse Observability
LANGFUSE_PUBLIC_KEY=pk-lf-dummy
LANGFUSE_SECRET_KEY=sk-lf-dummy
LANGFUSE_BASE_URL=http://localhost:3000

# Optional: Firecrawl Scraping
FIRECRAWL_URL=http://localhost:3005
FIRECRAWL_API_KEY=

# Optional: only used by the agent's own model listing endpoint (/api/models)
# Provider connection config is now sent by the backend
# LLM_MODEL_API_URL=http://localhost:1234

# Redis (mission event store — required for /api/v1/missions/:id/stream)
# If unreachable, mission stream endpoints return 503; chat still works.
REDIS_URL=redis://localhost:6379

