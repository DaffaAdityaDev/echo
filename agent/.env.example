PORT=3001
STATE_BACKEND=memory
# Must equal INTERNAL_AUTH_TOKEN in backend/.env
INTERNAL_AUTH_TOKEN=change-me-internal-token
SERVICE_JWT_SECRET=change-this-to-a-secure-service-jwt-secret-min32chars
BACKEND_URL=http://localhost:8080
NODE_ENV=development
# Streams debug packets (full system prompt) to clients and writes debug/ dumps. Never enable in production.
DEBUG_PROMPT=false

# Langfuse Observability
LANGFUSE_PUBLIC_KEY=pk-lf-dummy
LANGFUSE_SECRET_KEY=sk-lf-dummy
LANGFUSE_BASE_URL=http://localhost:3000

# Optional: MCP tools over SSE
# ENABLE_MCP=true
# MCP_SERVER_URL=http://localhost:8000/sse

# Optional: only used by the agent's own model listing endpoint (/api/models)
# Provider connection config is now sent by the backend
# LLM_MODEL_API_URL=http://localhost:1234

# Redis (optional prompt cache). If unreachable the agent logs a warning and fetches prompts from the backend each time.
REDIS_URL=redis://localhost:6379

