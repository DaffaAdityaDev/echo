{
  "name": "echo-agent",
  "version": "1.0.0",
  "description": "Node.js Agent for Echo",
  "main": "dist/index.js",
  "scripts": {
    "docs": "node api/merge.mjs",
    "build": "bun run docs && bun build ./src/index.ts --outdir ./dist --target bun --minify",
    "start": "bun run dist/index.js",
    "dev": "bun --watch src/index.ts",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@dqbd/tiktoken": "^1.0.22",
    "@langchain/anthropic": "^1.3.29",
    "@langchain/core": "^1.1.45",
    "@langchain/openai": "^1.2.4",
    "@langfuse/langchain": "^5.4.1",
    "@langfuse/otel": "^5.4.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.218.0",
    "@opentelemetry/sdk-node": "^0.218.0",
    "@opentelemetry/sdk-trace-base": "^2.0.1",
    "@scalar/hono-api-reference": "^0.5.171",
    "hono": "^4.12.18",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.13.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
